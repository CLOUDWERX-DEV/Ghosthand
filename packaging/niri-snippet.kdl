// Add to ~/.config/niri/config.kdl (inside `binds { ... }`, and the spawn-at-startup line at the top level).

// Take the pointer back from whatever is driving it, from anywhere. Pick any free key.
binds {
    Mod+Ctrl+Alt+Escape allow-inhibiting=false hotkey-overlay-title="Take the pointer back" { spawn "ghosthand" "revoke"; }
}

// Start the overlay with your session (or use the systemd user unit instead: systemctl --user enable --now ghosthand-overlay).
spawn-at-startup "ghosthand" "overlay"
